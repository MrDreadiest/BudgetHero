<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BudgetHero.App.Views.Content.Universal.CalculatorPopupContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
    xmlns:icons="clr-namespace:BudgetHero.App.Models.Icon"
    xmlns:lang="clr-namespace:BudgetHero.App.Resources.Languages"
    xmlns:universal="clr-namespace:BudgetHero.App.ViewModels.Content.Universal"
    x:DataType="universal:CalculatorPopupContentViewModel">

    <ContentView.Resources>

        <Style x:Key="CalculatorButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource LightOnDarkBackground}" />
            <Setter Property="FontSize" Value="{StaticResource size320}" />
        </Style>
    </ContentView.Resources>

    <bottomSheet:SfBottomSheet
        x:Name="bottomSheet"
        Background="{StaticResource DarkSecondaryBackground}"
        ContentPadding="{StaticResource LayoutPadding}"
        CornerRadius="15, 15, 0, 0"
        EnableSwiping="False"
        HalfExpandedRatio="0.65"
        ShowGrabber="False">
        <bottomSheet:SfBottomSheet.BottomSheetContent>
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <Frame BackgroundColor="{StaticResource DarkBackground}">
                    <VerticalStackLayout>
                        <ScrollView HorizontalOptions="End" Orientation="Horizontal">
                            <Label
                                FontSize="{StaticResource size400}"
                                HorizontalOptions="End"
                                LineBreakMode="NoWrap"
                                Style="{StaticResource LargeTitle}"
                                Text="{Binding ResultDisplay}"
                                VerticalOptions="End" />
                        </ScrollView>
                        <ScrollView HorizontalOptions="End" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="End"
                                LineBreakMode="NoWrap"
                                Style="{StaticResource Title1}"
                                Text="{Binding FormulaDisplay}"
                                TextColor="{StaticResource Gray400}"
                                VerticalOptions="Start" />
                        </ScrollView>

                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*">
                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Command="{Binding ClearFormulaCommand}"
                        Style="{StaticResource CalculatorButton}"
                        Text="C" />
                    <Button
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Command="{Binding DeleteLastCharacterCommand}"
                        Style="{StaticResource IconNavigateButton}"
                        Text="{x:Static icons:Icons.Backspace}" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="7"
                        Style="{StaticResource CalculatorButton}"
                        Text="7" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="8"
                        Style="{StaticResource CalculatorButton}"
                        Text="8" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="9"
                        Style="{StaticResource CalculatorButton}"
                        Text="9" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="/"
                        Style="{StaticResource CalculatorButton}"
                        Text="/" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="4"
                        Style="{StaticResource CalculatorButton}"
                        Text="4" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="5"
                        Style="{StaticResource CalculatorButton}"
                        Text="5" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="6"
                        Style="{StaticResource CalculatorButton}"
                        Text="6" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="3"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="*"
                        Style="{StaticResource CalculatorButton}"
                        Text="*" />

                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="1"
                        Style="{StaticResource CalculatorButton}"
                        Text="1" />
                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="2"
                        Style="{StaticResource CalculatorButton}"
                        Text="2" />
                    <Button
                        Grid.Row="3"
                        Grid.Column="2"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="3"
                        Style="{StaticResource CalculatorButton}"
                        Text="3" />
                    <Button
                        Grid.Row="3"
                        Grid.Column="3"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="-"
                        Style="{StaticResource CalculatorButton}"
                        Text="-" />

                    <Button
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="0"
                        Style="{StaticResource CalculatorButton}"
                        Text="0" />
                    <Button
                        Grid.Row="4"
                        Grid.Column="2"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter=","
                        Style="{StaticResource CalculatorButton}"
                        Text="," />
                    <Button
                        Grid.Row="4"
                        Grid.Column="3"
                        Command="{Binding AppendToFormulaCommand}"
                        CommandParameter="+"
                        Style="{StaticResource CalculatorButton}"
                        Text="+" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource LayoutSpacing}">
                    <Button
                        Grid.Column="0"
                        Command="{Binding ToggleViewCommand}"
                        Text="Zamknij" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding AcceptCommand}"
                        Text="Zatwierdź" />

                </Grid>

            </VerticalStackLayout>
        </bottomSheet:SfBottomSheet.BottomSheetContent>
    </bottomSheet:SfBottomSheet>

</ContentView>
