<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BudgetHero.App.Views.Content.Universal.DropdownAddTransactionCategoryContentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lang="clr-namespace:BudgetHero.App.Resources.Languages"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:sfExpander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:universal="clr-namespace:BudgetHero.App.ViewModels.Content.Universal"
    xmlns:universalViews="clr-namespace:BudgetHero.App.Views.Content.Universal"
    x:DataType="universal:AddInlistCategoryContentViewModel">

    <Border
        HorizontalOptions="Center"
        Stroke="{AppThemeBinding Light={StaticResource DarkOnLightBackground},
                                 Dark={StaticResource LightOnDarkBackground}}"
        Style="{StaticResource ExpanderOuterBorder}"
        VerticalOptions="Center">

        <sfExpander:SfExpander IsExpanded="{Binding IsOpen}">
            <sfExpander:SfExpander.Header>
                <Grid Padding="{StaticResource LayoutPadding}" ColumnDefinitions="Auto,*">
                    <Label
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Style="{StaticResource Title2}"
                        Text="{Binding Title}"
                        VerticalOptions="Center" />
                </Grid>
            </sfExpander:SfExpander.Header>
            <sfExpander:SfExpander.Content>
                <Grid Padding="{StaticResource LayoutPadding}" BackgroundColor="{StaticResource DarkBackground}">
                    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource LayoutSpacing}">
                            <Button
                                Grid.Column="0"
                                Command="{Binding IconSelectVM.ToggleViewCommand}"
                                Style="{StaticResource IconFramedButton}"
                                Text="{Binding IconSelectVM.SelectedIconItem.Unicode}" />

                            <sf:SfTextInputLayout Grid.Column="1" Hint="{x:Static lang:AppResource.FirstSetup_CategoriesContentView_Entry_Name}">
                                <Entry Text="{Binding TemporaryCategory.Name}" />
                            </sf:SfTextInputLayout>
                        </Grid>
                        <Label Style="{StaticResource Caption1}" Text="{x:Static lang:AppResource.FirstSetup_CategoriesContentView_Label_Hint}" />
                        <Button Command="{Binding AddCategoryCommand}" Text="{x:Static lang:AppResource.FirstSetup_CategoriesContentView_Button_Add}" />
                    </VerticalStackLayout>
                    <universalViews:ActivityIndicator IsBusy="{Binding IsBusy}" />
                </Grid>
            </sfExpander:SfExpander.Content>
        </sfExpander:SfExpander>
    </Border>
</ContentView>
