<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BudgetHero.App.Views.Details.Shortcuts.SplitTransactionDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
    xmlns:icons="clr-namespace:BudgetHero.App.Models.Icon"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:lang="clr-namespace:BudgetHero.App.Resources.Languages"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:sfData="clr-namespace:Syncfusion.Maui.DataSource;assembly=Syncfusion.Maui.DataSource"
    xmlns:sfDataExt="clr-namespace:Syncfusion.Maui.DataSource.Extensions;assembly=Syncfusion.Maui.DataSource"
    xmlns:sfEditors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfListView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:shortcuts="clr-namespace:BudgetHero.App.ViewModels.Details.Shortcuts"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:transactions="clr-namespace:BudgetHero.App.ViewModels.Content.Transactions"
    xmlns:universalViews="clr-namespace:BudgetHero.App.Views.Content.Universal"
    Title="{Binding Title}"
    x:DataType="shortcuts:SplitTransactionDetailViewModel"
    Shell.NavBarHasShadow="True"
    Shell.TabBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding NavigatedToCommand}" EventName="NavigatedTo" />
        <toolkit:EventToCommandBehavior Command="{Binding NavigatedFromCommand}" EventName="NavigatedFrom" />
        <toolkit:EventToCommandBehavior Command="{Binding AppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.ToolbarItems />

    <Grid>


        <Grid Margin="{StaticResource LayoutMargin}" RowDefinitions="Auto,*">
            <Border VerticalOptions="Start">
                <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                    <Grid
                        Margin="0,5,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="{StaticResource LayoutSpacing}">
                        <sf:SfTextInputLayout Grid.Column="0" Hint="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Entry_Date}">
                            <DatePicker Date="{Binding SelectedDate}" />
                        </sf:SfTextInputLayout>

                        <sf:SfTextInputLayout Grid.Column="1" Hint="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Entry_Time}">
                            <TimePicker Time="{Binding SelectedTime}" />
                        </sf:SfTextInputLayout>
                    </Grid>

                    <Grid ColumnDefinitions="1*,4*" ColumnSpacing="{StaticResource LayoutSpacing}">
                        <VerticalStackLayout Spacing="5">
                            <Label
                                Grid.Row="1"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource Body2}"
                                Text="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Button_DropRest}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Start" />

                            <Button
                                Command="{Binding DropRestCommand}"
                                Style="{StaticResource IconFramedButton}"
                                Text="{x:Static icons:Icons.ArrowDown}" />

                        </VerticalStackLayout>
                        <inputLayout:SfTextInputLayout Grid.Column="1" Hint="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Entry_SplitAmount}">
                            <sfEditors:SfNumericEntry
                                x:Name="AmountToSeparate"
                                ValueChanged="AmountToSeparate_ValueChanged"
                                Value="{Binding AmountToSeparate}" />
                        </inputLayout:SfTextInputLayout>
                    </Grid>

                    <universalViews:DropdownPickerTransactionCategoryContentView BindingContext="{Binding DropdownTransactionCategoryVM}" />

                    <sf:SfTextInputLayout Hint="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Entry_Name}">
                        <Entry Text="{Binding TemporaryTransaction.Name}" />
                    </sf:SfTextInputLayout>

                    <sf:SfTextInputLayout Hint="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Entry_Description}">
                        <Entry Text="{Binding TemporaryTransaction.Description}" />
                    </sf:SfTextInputLayout>

                    <Grid ColumnDefinitions="1*,4*" ColumnSpacing="{StaticResource LayoutSpacing}">
                        <VerticalStackLayout Spacing="5">
                            <Label
                                Grid.Row="1"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource Body2}"
                                Text="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Button_Calculate}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Start" />

                            <Button
                                Command="{Binding CalculatorPopupContentVM.ToggleViewCommand}"
                                Style="{StaticResource IconFramedButton}"
                                Text="{x:Static icons:Icons.Calculate}" />
                        </VerticalStackLayout>

                        <inputLayout:SfTextInputLayout Grid.Column="1" Hint="{x:Static lang:AppResource.Shortcut_AddTransactionDetailView_Entry_TotalAmount}">
                            <sfEditors:SfNumericEntry
                                x:Name="TotalAmount"
                                ValueChanged="TotalAmount_ValueChanged"
                                Value="{Binding TemporaryTransaction.TotalAmount}" />
                        </inputLayout:SfTextInputLayout>
                    </Grid>

                    <Button Command="{Binding SeparateTransactionCommand}" Text="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Button_Add}" />
                </VerticalStackLayout>
            </Border>

            <Grid
                Grid.Row="1"
                RowDefinitions="*,Auto"
                RowSpacing="{StaticResource LayoutSpacing}">
                <sfListView:SfListView
                    Grid.Row="0"
                    IsScrollingEnabled="True"
                    ItemsSource="{Binding SeparatedTransaction}"
                    SelectionMode="None">

                    <sfListView:SfListView.EmptyView>
                        <Grid>
                            <Label
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Caption1Strong}"
                                Text="{x:Static lang:AppResource.General_Views_NoItems}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </sfListView:SfListView.EmptyView>

                    <sfListView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="transactions:TransactionListItem">
                            <Grid
                                Background="{AppThemeBinding Light={StaticResource LightBackground},
                                                             Dark={StaticResource DarkBackground}}"
                                ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                RowDefinitions="*,*"
                                VerticalOptions="Center">

                                <Border
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Style="{StaticResource IconFrameTransactionBorder}">
                                    <Label Style="{StaticResource MaterialFramedIcon}" Text="{Binding TransactionCategory.IconUnicode}" />
                                </Border>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource Body1}"
                                    Text="{Binding Transaction.Name}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource Caption1}"
                                    Text="{Binding Transaction.Description}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Body1}"
                                    Text="{Binding Transaction.TotalAmount, StringFormat='{0:C2}'}"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.RowSpan="2"
                                    Grid.Column="3"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type shortcuts:SplitTransactionDetailViewModel}}, Path=UndoSeparationCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource IconNavigateButton}"
                                    Text="{x:Static icons:Icons.Close}" />
                            </Grid>
                        </DataTemplate>
                    </sfListView:SfListView.ItemTemplate>
                </sfListView:SfListView>
                <Button
                    Grid.Row="1"
                    Command="{Binding SaveTransactionsCommand}"
                    Text="{x:Static lang:AppResource.Shortcut_SplitTransactionDetailView_Button_AddAll}" />
            </Grid>


            <universalViews:DropdownSelectTransactionCategoryContentView Grid.RowSpan="2" BindingContext="{Binding DropdownTransactionCategoryVM}" />
            <universalViews:IconSelectContentView Grid.RowSpan="2" BindingContext="{Binding DropdownTransactionCategoryVM.AddInlistCategoryVM.IconSelectVM}" />
            <universalViews:ActivityIndicator Grid.RowSpan="2" IsBusy="{Binding IsBusy}" />
        </Grid>

        <universalViews:CalculatorPopupContentView Grid.RowSpan="2" BindingContext="{Binding CalculatorPopupContentVM}" />
    </Grid>
</ContentPage>